# --- Postgres (warehouse) ---
WAREHOUSE_USER=dw
WAREHOUSE_PASSWORD=troque-esta-senha
WAREHOUSE_DB=warehouse
POSTGRES_PORT=5432

# --- Postgres (metadados do Airflow, mesmo servidor) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=troque-esta-senha
AIRFLOW_DB_NAME=airflow

# --- MinIO (data lake S3) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-esta-senha-8+
LAKE_BUCKET=lake
S3_ENDPOINT_URL=http://localhost:9000

# --- Airflow ---
AIRFLOW_UID=50000
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=troque-por-um-valor-aleatorio

# --- Imagens (fixe versões para reprodutibilidade) ---
AIRFLOW_IMAGE=apache/airflow:3.1.0
MINIO_IMAGE=minio/minio:latest
MC_IMAGE=minio/mc:latest
