# --- Postgres (warehouse) ---
WAREHOUSE_USER=dw
WAREHOUSE_PASSWORD=troque-esta-senha
WAREHOUSE_DB=warehouse
POSTGRES_PORT=5432

# --- Postgres (metadados do Airflow, mesmo servidor) ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=troque-esta-senha
AIRFLOW_DB_NAME=airflow

# --- RustFS (data lake S3) ---
LAKE_ACCESS_KEY=lakeadmin
LAKE_SECRET_KEY=troque-esta-senha-8+
LAKE_BUCKET=lake
S3_ENDPOINT_URL=http://localhost:9000

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_PORT=8080   # porta do Airflow no seu PC
# Gere um valor aleatório: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=troque-por-um-valor-aleatorio

# --- Imagens (fixe versões para reprodutibilidade) ---
LAKE_IMAGE=rustfs/rustfs:latest
